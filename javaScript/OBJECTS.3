let produto = {
    nome: 'Macarrão',
    precoOriginal: 24,
    desconto: 0.15, // 15%
    
    calcularPrecoFinal: function () {
        // Preço original menos o valor do desconto
        return this.precoOriginal * (1 - this.desconto);
    }
};

console.log(`Produto: ${produto.nome} - R$ ${produto.precoOriginal.toFixed(2)}`);

console.log(`Preço final com desconto: R$ ${produto.calcularPrecoFinal().toFixed(2)}`);
