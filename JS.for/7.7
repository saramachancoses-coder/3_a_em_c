let totalNegativos = 0;

for (let i = 1; i <= 8; i++) {
    let numero = -3; // Simula o usuário digitando um número (ex: -3, 5, -1...)
    
    if (numero < 0) {
        totalNegativos++; // Soma mais 1 na quantidade de ocorrências
    }
}

console.log("Total de números negativos digitados: " + totalNegativos);
