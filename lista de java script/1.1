// 1. Verificar Idade
let idade = 20;
if (idade >= 18) {
    console.log("Maior de idade");
} else {
    console.log("Menor de idade");
}

// 2. Número Positivo ou Negativo
let numeroSinal = -5;
if (numeroSinal > 0) {
    console.log("Positivo");
} else if (numeroSinal < 0) {
    console.log("Negativo");
} else {
    console.log("Zero");
}

// 3. Login do Utilizador
let utilizador = "admin";
if (utilizador === "admin") {
    console.log("Bem-vindo, administrador!");
} else {
    console.log("Bem-vindo, utilizador comum!");
}

// 4. Par ou Ímpar
let numeroParImpar = 7;
if (numeroParImpar % 2 === 0) {
    console.log("Par");
} else {
    console.log("Ímpar");
}

// 5. Aprovação Escolar
let nota = 12;
if (nota >= 10) {
    console.log("Aprovado");
} else {
    console.log("Reprovado");
}

// 6. Comparar Dois Números
let a = 15;
let b = 22;
if (a > b) {
    console.log("O maior número é o 'a' (" + a + ")");
} else if (b > a) {
    console.log("O maior número é o 'b' (" + b + ")");
} else {
    console.log("Os números são iguais");
}

// 7. Desconto de Quantidade
let itens = 6;
if (itens > 5) {
    console.log("Tens direito a um desconto!");
} else {
    console.log("Sem desconto disponível");
}


// 8. Verificar Temperatura
let temperatura = 32;
if (temperatura > 30) {
    console.log("Está calor");
} else {
    console.log("Está um clima agradável");
}

// 9. Dia da Semana
let diaSemana = 6; // Exemplo: 6 representa Sábado
if (diaSemana === 6 || diaSemana === 7) {
    console.log("É fim de semana!");
} else {
    console.log("É dia útil!");
}

// 10. Vogal ou Consoante
let letra = "e";
// Convertemos para minúscula para garantir que funciona com "E" ou "e"
let letraMinuscula = letra.toLowerCase(); 

if (letraMinuscula === 'a' || letraMinuscula === 'e' || letraMinuscula === 'i' || letraMinuscula === 'o' || letraMinuscula === 'u') {
    console.log("Vogal");
} else {
    console.log("Consoante");
}
